PORT=8080
MONGO_URI=mongodb://localhost:27017/markmyseat
JWT_SECRET=change_me_to_a_random_string
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Redis — used for seat locking & booking queue (BullMQ)
# Get a free 30MB instance from https://redis.io/cloud (Redis Cloud)
# or use Upstash: https://upstash.com (10K commands/day free)
# Leave empty to disable Redis — booking still works via MongoDB transactions alone
REDIS_URL=redis://default:your_password@your_host:6379